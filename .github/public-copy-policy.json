{
  "schema_version": 1,
  "description": "Check words shown to readers; machine fields, source code symbols and comments are outside this copy check.",
  "rules": [
    {
      "pattern": "\\bcanonical\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\b(?:evidence|source) registry\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bsource-review\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bpublic projection\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bprivate provenance\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bmetadata schema\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\b(?:publication|privacy|rights) audit\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bhandback\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bQA\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bsanitized\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bimplementation(?: revision)?\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\bapproved (?:public |display )?derivative\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\b(?:reader-facing|publication status|completion verified|record count)\\b",
      "issue": "internal_language"
    },
    {
      "pattern": "\\b(?:Four areas of shared work|Mapping in relationship with people and place)\\b",
      "issue": "too_abstract"
    }
  ],
  "allowed_rules_by_context": {},
  "reader_json_fields": [
    "name",
